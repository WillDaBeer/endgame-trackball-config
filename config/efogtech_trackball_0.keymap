#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/adaptive_feedback.h>
#include <dt-bindings/zmk/bistable_behavior.h>
#include <dt-bindings/zmk/p2sm.h>

#ifndef LAYER_DEFAULT
#define LAYER_DEFAULT      0
#define LAYER_CAD          1
#define LAYER_EXTRAS       2
#define LAYER_DEVICE       3
#define LAYER_SCROLL       4
#define LAYER_SNIPE        5
#endif

/ {
	behaviors {
		bst_desk_next: bst_desk_next {
			compatible = "zmk,behavior-bistable";
			display-name = "Next desktop (OS-dependent)";
			#binding-cells = <0>;
			bindings = <&kp LG(LC(RIGHT))>, <&kp LC(RIGHT)>;
		};

		bst_redo: bst_redo {
			compatible = "zmk,behavior-bistable";
			display-name = "Redo (OS-dependent)";
			#binding-cells = <0>;
			bindings = <&kp LC(Y)>, <&kp LG(LS(Z))>;
		};

		cad_orbit: cad_orbit {
			compatible = "zmk,behavior-macro";
			display-name = "CAD orbit (Shift + middle button)";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <0>;
			bindings = <&macro_press &kp LSHIFT &mkp MCLK>,
			           <&macro_pause_for_release>,
			           <&macro_release &mkp MCLK &kp LSHIFT>;
		};

		cad_fit: cad_fit {
			compatible = "zmk,behavior-macro";
			display-name = "CAD fit view (F6 Fusion, Z Bambu)";
			#binding-cells = <0>;
			wait-ms = <20>;
			tap-ms = <20>;
			bindings = <&macro_tap &kp F6 &kp Z>;
		};

		ht_fit: hold_tap_fit {
			compatible = "zmk,behavior-hold-tap";
			display-name = "Hold/tap (layer/CAD fit)";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <200>;
			bindings = <&mo>, <&cad_fit>;
			hold-while-undecided;
		};

		bst_desk_prev: bst_desk_prev {
			compatible = "zmk,behavior-bistable";
			display-name = "Previous desktop (OS-dependent)";
			#binding-cells = <0>;
			bindings = <&kp LG(LC(LEFT))>, <&kp LC(LEFT)>;
		};
	};

	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Default";
			DECLARE_ENCODERS;
			bindings = <
			    // buttons
			    &ltmkp LAYER_SNIPE ENTER  &mkp MCLK
			    &ltmkp LAYER_SCROLL ESC   &cdch LAYER_SCROLL 0
			    &mkp LCLK                 &ltmkp LAYER_EXTRAS C_PLAY_PAUSE
			    &mkp RCLK                 &lt LAYER_DEVICE C_MUTE

			    // rotary encoders
			    &bst_desk_prev            &kp C_VOL_UP
			    &bst_desk_next            &kp C_VOL_DN
		    >;
		};

		cad_layer {
			display-name = "CAD";
			DECLARE_ENCODERS;
			bindings = <
			    &trans         &trans
			    &trans         &cad_orbit
			    &trans         &ht_fit LAYER_EXTRAS 0
			    &trans         &trans

			    &bst_undo      &scroll_up
			    &bst_redo      &scroll_down
			>;
		};

		layer1 {
			display-name = "Extras";
			DECLARE_ENCODERS;
			bindings = <
			    &bst_copy      &bst_paste
			    &bst_cut       &bst_undo
			    &bst_undo      &trans
			    &bst_copy      &bst_paste

			    &bst_desk_prev &kp C_VOL_UP
			    &bst_desk_next &kp C_VOL_DN
	   		>;
		};

		layer2 {
			display-name = "Device";
			DECLARE_ENCODERS;
			bindings = <
			    &mui_or_dgl          &bt BT_CLR
			    &bst_tog ZBS_TOG     &bt BT_NXT
			    &af_toggle AF_TOG    &bt BT_PRV
			    &studio_unlock       &trans

			    &bst_desk_prev       &kp C_VOL_UP
			    &bst_desk_next       &kp C_VOL_DN
		   	>;
		};

		layer3 {
			display-name = "Scroll";
			DECLARE_ENCODERS;
			bindings = <
			    &trans              &trans
			    &trans              &trans
			    &rrl 1              &trans
			    &trans              &trans

			    &sens P2SM_DEC 1    &scrlsens P2SM_INC 1
			    &sens P2SM_INC 1    &scrlsens P2SM_DEC 1
		  	>;
		};

		layer4 {
			display-name = "Snipe";
			DECLARE_ENCODERS;
			bindings = <
			    &trans           &soft_off
			    &trans           &tog LAYER_CAD
			    &trans           &trans
			    &trans           &trans

			    &kp LEFT         &kp RIGHT
			    &kp RIGHT        &kp LEFT
	   		>;
		};

	};

	trackball {
		input-processors = <&zip_bistable_twist_scaler>,
						   <&zip_pointer_accel>, <&zip_scroll_accel>, <&zip_rotate_pointer>,
		                   <&esb_ip>, <&zip_ble_report_rate_limit>;

		scroll {
			layers = <LAYER_SCROLL>;
			input-processors = <&zip_bistable_scroll_xy_scaler>, <&zip_axis_clamper>,
							   <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
							   <&zip_dragscroll_accel>, <&zip_rotate_scroll>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};

		snipe {
			layers = <LAYER_SNIPE>;
			input-processors = <&zip_bistable_snipe_scaler>, <&zip_rotate_pointer>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};
	};
};
